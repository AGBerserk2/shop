# Same as .gitignore + a few cloud-specific extras
.git
.github
.husky
.vscode
.idea

node_modules
packages/*/node_modules
packages/*/dist

npm-debug.log
yarn-debug.log
yarn-error.log
.DS_Store
*.log

# Secrets — never upload to Cloud Build context.
secrets/
*.pem
*.key
.env
.env.*
!.env.example

# Helper scripts and boilerplate not needed for the build
scripts/
README.md
LICENSE
